<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include user bookmarks, reading progress, and preferences -->
    <include domain="sharedpref" path="."/>
    <include domain="database" path="."/>

    <!-- Exclude heavy audio streaming caches, temporary video buffers, and glitch logs from slow backups -->
    <exclude domain="root" path="cache/"/>
    <exclude domain="external" path="cache/"/>
    <exclude domain="file" path="image_cache/"/>
    <exclude domain="file" path="audio_cache/"/>
    <exclude domain="file" path="media_temp/"/>
</full-backup-content>
