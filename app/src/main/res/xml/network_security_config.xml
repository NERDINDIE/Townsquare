<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Baseline secure network communication rules with optimized trust anchors -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Specific rules for media streaming CDN & radio broadcast audio streams -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">storage.googleapis.com</domain>
        <domain includeSubdomains="true">run.app</domain>
        <domain includeSubdomains="true">images.unsplash.com</domain>
        <domain includeSubdomains="true">picsum.photos</domain>
        <domain includeSubdomains="true">fastly.net</domain>
        <domain includeSubdomains="true">cloudfront.net</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
