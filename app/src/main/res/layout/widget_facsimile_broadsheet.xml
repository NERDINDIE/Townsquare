<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_fax_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_facsimile"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Retro Facsimile Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📠 TOWNSQUARE FACSIMILE WIRE"
            android:textColor="#8B5E14"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_fax_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EDITION #08 • 08:00 HRS"
            android:textColor="#5C5544"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:background="#D0C4A8" />

    <!-- Main Headline -->
    <TextView
        android:id="@+id/widget_fax_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="SOLAR TRAMWAY COMMENCES WATERFRONT RUNS"
        android:textColor="#1A1814"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Subheadline / Wire Bulletins -->
    <TextView
        android:id="@+id/widget_fax_bulletin_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="• 08:08 Port harbor gates clear for deep-draft transit"
        android:textColor="#3D382E"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_fax_bulletin_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="• 08:24 City Hall tables protected bike network vote"
        android:textColor="#3D382E"
        android:textSize="11sp" />

    <!-- Space filler -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="6dp"
        android:background="#D0C4A8" />

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_fax_carrier"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="142.85 MHz • 120 RPM"
            android:textColor="#7A715C"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_fax_btn_read"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E8DFCE"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="TEAR SLIP ▾"
            android:textColor="#3A3427"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
